# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required for --extractor agent (the default path).
ANTHROPIC_API_KEY=

# Optional. Overrides the model; must be a LiteLLM model id.
# AP_FLOW_MODEL=anthropic/claude-opus-5

# Optional. Only raises the GitHub API rate limit; public repos work without it.
# GITHUB_TOKEN=
